# Copy to .env and edit.
PORT=3001
WEB_ORIGIN=http://localhost:5173

# ---- Weather (Open-Meteo, no key needed) ----
# Initial location — only a seed. Change it later at /setup (saved to
# server/data/settings.json). Coordinates in decimal degrees.
LATITUDE=40.7128
LONGITUDE=-74.0060
DEFAULT_CITY=New York
DEFAULT_REGION=New York
# "celsius" or "fahrenheit"
TEMPERATURE_UNIT=fahrenheit
# How many days of forecast to show (1-16).
FORECAST_DAYS=7

# ---- News ----
# Seed category; change it at /setup or by voice ("set news to science").
# top | world | business | technology | science | health | sports | entertainment
NEWS_CATEGORY=technology

# ---- Google Calendar ----
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Application type: "Web application"). Enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ---- Music ----
# Default source is Audius (free, no key). This is just an app-name label it
# asks you to send; anything is fine.
AUDIUS_APP_NAME=mirror-mirror

# Spotify is used only if you link a PREMIUM account (Free is rejected).
# Create an app at https://developer.spotify.com/dashboard, add the redirect
# URI below verbatim, and add yourself under the app's "User Management" tab.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be the loopback IP — Spotify rejects "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/spotify/callback

# ---- Voice assistant ----
# Wake phrase — only a seed; change it at /setup or by voice ("setup").
WAKE_PHRASE=mirror mirror on the wall

# Local model tier (Ollama) — used for the router and the memory synthesizer,
# both of which need low latency more than deep reasoning.
# Pull a model first:  ollama pull llama3.2:3b   (~1s answers on a laptop)
# Prefer quality and don't mind ~15s?  ollama pull qwen3:8b  and set it here.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud model tier (Claude). Only used when a request needs it and this is set.
# Get a key at https://console.anthropic.com/ . Leave blank to stay local-only.
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-opus-5

# ---- Personal memory (RAG) ----
# Embeddings run locally so personal data never leaves the machine:
#   ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
# Never send retrieved snippets to the cloud model (recall only answers when the
# local model is up). "1" = strict local.
MEMORY_LOCAL_ONLY=0
# Recency weighting: how many days until a memory's boost halves.
MEMORY_HALFLIFE_DAYS=14
# Also index the last 90 days of Google Calendar events.
MEMORY_INDEX_CALENDAR=0
